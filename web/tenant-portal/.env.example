# M19 租户门户环境变量示例（复制为 .env.local 后填值）。
#
# dev 栈：先 `docker compose -f deploy/dev/docker-compose.yml up -d`
# 起好 Keycloak + APISIX + tenant-bc，再 `cp .env.example .env.local` 并填 AUTH_SECRET。

# Auth.js v5 必需：会话 cookie 加密密钥（`openssl rand -base64 32` 或随机 32+ 字节）。
AUTH_SECRET=

# 门户自身 URL（Auth.js 回调基址；dev 跑宿主 :3000）。
AUTH_URL=http://localhost:3000

# Keycloak OIDC 提供者（经 APISIX :9080 代理，浏览器面 issuer 与令牌 iss 一致）。
AUTH_KEYCLOAK_ID=jsl-gateway
AUTH_KEYCLOAK_SECRET=dev-gateway-secret
AUTH_KEYCLOAK_ISSUER=http://localhost:9080/realms/jsl

# BFF → APISIX /api/* 基址（门户服务端调，持 access_token 作 Bearer）。
APISIX_API_BASE=http://localhost:9080/api
